{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeStreamTelemetryEvent",
  "description": "Standardized schema contract for industrial asset telemetry in ForgeStream Phase 1",
  "type": "object",
  "required": [
    "event_id",
    "asset_id",
    "asset_type",
    "timestamp",
    "event_time",
    "temperature",
    "vibration",
    "pressure",
    "rpm",
    "current",
    "voltage",
    "power",
    "load",
    "operating_mode",
    "sequence_number",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the telemetry event"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^(MOTOR|PUMP|COMPRESSOR|CONVEYOR|TURBINE)-[0-9]{3}$",
      "description": "Deterministic asset identifier"
    },
    "asset_type": {
      "type": "string",
      "enum": ["MOTOR", "PUMP", "COMPRESSOR", "CONVEYOR", "TURBINE"]
    },
    "timestamp": {
      "type": "number",
      "description": "Unix epoch timestamp in seconds"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of event generation"
    },
    "ingestion_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "temperature": {
      "type": "number",
      "minimum": -50.0,
      "maximum": 1500.0,
      "description": "Operating temperature in °C"
    },
    "vibration": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 500.0,
      "description": "RMS vibration in mm/s"
    },
    "pressure": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1000.0,
      "description": "Pressure in bar"
    },
    "rpm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 50000.0,
      "description": "Rotational speed in RPM"
    },
    "current": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5000.0,
      "description": "Current in Amperes"
    },
    "voltage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 50000.0,
      "description": "Voltage in Volts"
    },
    "power": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100000.0,
      "description": "Active power in kW"
    },
    "load": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Mechanical load percentage"
    },
    "operating_mode": {
      "type": "string",
      "enum": ["IDLE", "STARTUP", "NORMAL", "HIGH_LOAD", "MAINTENANCE", "DEGRADED"]
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "metadata": {
      "type": "object",
      "description": "Ground truth evaluation metadata (segregated from predictive feature set)",
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "maintenance_state": {
          "type": "string",
          "enum": ["HEALTHY", "NEEDS_INSPECTION", "WARNING", "CRITICAL"]
        },
        "is_synthetic": {
          "type": "boolean"
        },
        "ground_truth_rul_hours": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
