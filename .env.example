# ==============================================================================
# ForgeStream Environment Configuration (.env.example)
# ==============================================================================

# Simulation Parameters
FORGE_SIM_SEED=42
FORGE_SIM_EVENT_RATE_HZ=10
FORGE_SIM_ASSET_COUNT=5
FORGE_SIM_DURATION_SEC=30

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=forgestream-producer-01
KAFKA_TOPIC_TELEMETRY=industrial-telemetry
KAFKA_TOPIC_MAINTENANCE=maintenance-events
KAFKA_TOPIC_ALERTS=asset-alerts
KAFKA_TOPIC_MODELS=model-events
KAFKA_TOPIC_METRICS=system-metrics
KAFKA_AUTO_OFFSET_RESET=earliest

# PostgreSQL Configuration (Operational Metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forgestream_db
POSTGRES_USER=forgestream_user
POSTGRES_PASSWORD=forgestream_secret

# Apache Iceberg Configuration (Historical Storage)
# Uses PyIceberg SqlCatalog with SQLite by default for zero-JVM local operation
ICEBERG_CATALOG_TYPE=sql
ICEBERG_CATALOG_URI=sqlite:///data/catalog.db
ICEBERG_WAREHOUSE_PATH=file:///data/warehouse
ICEBERG_NAMESPACE=forgestream
ICEBERG_TABLE_TELEMETRY=historical_telemetry

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
